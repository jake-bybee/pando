IMMICH_URL=http://immich:2283
IMMICH_API_TOKEN=replace-with-an-immich-api-key

# URL of this Pando peer, reachable by the other peers
SELF_URL=http://pando-1:8080

# URL of any running peer, used once at startup to join the cluster
BOOTSTRAP_PEER_URL=http://pando-1:8080

LISTEN_PORT=8080
BACKUP_FOLDER_PATH=/var/lib/pando
NUM_PEERS=3
NUM_REPLICAS=2
TIME_ZONE=UTC
MIN_FREE_BYTES=5368709120
STORAGE_RECHECK_SECONDS=60