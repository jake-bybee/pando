IMMICH_URL=http://immich:2283
IMMICH_API_TOKEN=replace-with-an-immich-api-key

# URL of this Pando peer, reachable by the other peers
SELF_URL=http://pando-1:8080

# URL of the peer used for initial registration
MASTER_PANDO_URL=http://pando-1:8080
# Used only when MASTER_PANDO_URL is not set and IMMICH_URL includes a port
MASTER_PANDO_PORT=8080

LISTEN_PORT=8080
BACKUP_FOLDER_PATH=/var/lib/pando
NUM_PEERS=3
NUM_REPLICAS=2
TIME_ZONE=UTC